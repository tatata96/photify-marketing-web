# Required for the /api/lead serverless function (Vercel).
# Set these in your hosting provider's project settings — never commit real values.

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender. The domain (photify.studio) must be verified in Resend first
# at https://resend.com/domains — otherwise sends will fail.
EMAIL_FROM=Photify <noreply@photify.studio>

# Inbox that receives lead notifications.
EMAIL_TO=info@photify.studio
